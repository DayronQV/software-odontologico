# ============================================================
# SIGO-Dental — variables para Docker Compose (raíz del repo)
# Copia a `.env` si quieres cambiar algo. Todos los valores de abajo
# son SOLO DE DESARROLLO: en producción cámbialos todos.
# Si no creas `.env`, docker-compose.yml usa estos mismos valores.
# ============================================================

# --- PostgreSQL (puerto de host 5433 para no chocar con un Postgres local en 5432)
POSTGRES_USER=sigo
POSTGRES_PASSWORD=sigo_dev_password
POSTGRES_DB=sigo
POSTGRES_PORT=5433

# --- Redis
REDIS_PASSWORD=sigo_redis_dev

# --- MinIO (almacenamiento tipo S3)
MINIO_ROOT_USER=sigo_minio
MINIO_ROOT_PASSWORD=sigo_minio_dev_password
MINIO_BUCKET=sigo-files
# Clave KMS de MinIO para cifrado del lado del servidor (SSE-S3): "<nombre>:<32 bytes en base64>"
MINIO_KMS_SECRET_KEY=sigo-key:WsXiHS2Y4osgNZdexBVGoy8Bdr+i4s86oBQX0/ZEmEg=

# --- Backend (NestJS)
JWT_ACCESS_SECRET=39b9a1107a1223b26b793d2aaaf223fde62bc02920377422e5ed1643c82cb6bb
# AES-256-GCM: 32 bytes en base64 (openssl rand -base64 32)
ENCRYPTION_KEY=nOToCiHZwXXg7ow2HSJS98hdTqC88qPO9iHRP7ZjnbE=
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=604800
# Cierre de sesión por inactividad: 15 min (RNF-05)
SESSION_IDLE_SECONDS=900
# Orígenes permitidos por CORS (el gateway Nginx sirve todo en https://localhost)
CORS_ORIGIN=https://localhost,http://localhost:5173
THROTTLE_AUTH_LIMIT=5
THROTTLE_AUTH_TTL_SECONDS=60
# Crea los 5 usuarios semilla (uno por rol) al arrancar. NO usar en producción.
SEED_ON_START=true
SEED_PASSWORD=Sigo-Dev-2026!

# --- Frontend (build)
VITE_IDLE_MINUTES=15
