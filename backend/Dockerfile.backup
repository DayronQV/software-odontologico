# Imagen de respaldos: cliente de PostgreSQL 16 (pg_dump/pg_restore, misma versión que el servidor)
# + Node para cifrar (AES-256-GCM) y subir a almacenamiento S3. Comandos: backup | list | prune | restore | daemon.
FROM node:24-slim AS build
WORKDIR /app
RUN apt-get update -y && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY package*.json ./
RUN npm ci
COPY prisma ./prisma
RUN npx prisma generate
COPY tsconfig.json tsconfig.build.json nest-cli.json ./
COPY src ./src
RUN npm run build && npm prune --omit=dev

FROM postgres:16-alpine
RUN apk add --no-cache nodejs tzdata
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/package.json ./package.json
ENV TZ=America/Bogota
USER postgres
ENTRYPOINT ["node", "dist/backup/cli.js"]
CMD ["daemon"]
