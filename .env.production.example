# Plantilla de variables para docker-compose.prod.yml. Copie a .env.production (NO se versiona) y complete TODO.
# Generar secretos:
#   JWT_ACCESS_SECRET : openssl rand -hex 32
#   ENCRYPTION_KEY    : openssl rand -base64 32      (¡respáldela fuera del servidor! sin ella los datos cifrados son irrecuperables)
#   contraseñas       : openssl rand -base64 24
#   MINIO_KMS_SECRET_KEY : sigo-key:$(openssl rand -base64 32)

PUBLIC_URL=https://clinica.ejemplo.com

POSTGRES_USER=sigo
POSTGRES_PASSWORD=
POSTGRES_DB=sigo
REDIS_PASSWORD=

JWT_ACCESS_SECRET=
ENCRYPTION_KEY=

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_KMS_SECRET_KEY=
MINIO_BUCKET=sigo-files

# Correo transaccional real (recordatorios RF-11). Cualquier SMTP con capa gratuita.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="SIGO-Dental <no-reply@clinica.ejemplo.com>"

# Primer administrador (se crea una sola vez; el MFA se configura en su primer ingreso).
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Respaldos. Para separar los respaldos del servidor use un bucket de otro proveedor (Cloudflare R2, Backblaze B2).
BACKUP_S3_BUCKET=sigo-backups
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_RETENTION_DAYS=30
BACKUP_HOUR=2

SWAGGER_ENABLED=false
VITE_IDLE_MINUTES=15
